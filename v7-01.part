(()=>{const css="\n    :root{\n      --green:#00843D;\n      --green-dark:#00573F;\n      --green-light:#86D295;\n      --yellow:#FFCD00;\n      --red:#E2000F;\n      --ink:#152019;\n      --muted:#66726B;\n      --line:#D8E3DC;\n      --soft:#F2F7F4;\n      --white:#FFFFFF;\n      --danger:#B42318;\n      --shadow:0 14px 38px rgba(0,87,63,.11);\n    }\n    *{box-sizing:border-box}\n    html{scroll-behavior:smooth}\n    body{\n      margin:0;\n      font-family:Arial,Helvetica,sans-serif;\n      color:var(--ink);\n      background:linear-gradient(180deg,#e8f4ec 0,#f7faf8 280px,#f2f5f3 100%);\n    }\n    button,input,select,textarea{font:inherit}\n    button{cursor:pointer}\n    .page{max-width:1120px;margin:0 auto;padding:24px 18px 54px}\n    .hero{\n      position:relative;\n      overflow:hidden;\n      min-height:210px;\n      padding:30px 34px;\n      color:#fff;\n      background:var(--green);\n      border-radius:4px 4px 22px 22px;\n      box-shadow:var(--shadow);\n    }\n    .hero:after{\n      content:\"\";\n      position:absolute;\n      right:-46px;\n      bottom:-94px;\n      width:290px;\n      height:290px;\n      border:48px solid rgba(255,255,255,.085);\n      border-radius:52px;\n      transform:rotate(45deg);\n    }\n    .brand{display:flex;align-items:center;gap:13px;position:relative;z-index:1}\n    .brand-mark{width:44px;height:44px;flex:0 0 44px}\n    .brand-name{font-weight:700;font-size:27px;line-height:1;letter-spacing:-.5px}\n    .brand-rule{height:3px;width:122px;background:var(--red);margin-top:6px}\n    .brand-sub{font-size:9px;letter-spacing:.8px;margin-top:4px;opacity:.94}\n    .hero h1{position:relative;z-index:1;margin:30px 0 8px;font-size:36px;line-height:1.08;letter-spacing:-1px}\n    .hero p{position:relative;z-index:1;margin:0;color:#e7f6ec;max-width:720px;line-height:1.5}\n    .tag{position:absolute;right:28px;top:25px;z-index:2;background:var(--yellow);color:#344225;padding:9px 13px;font-size:12px;font-weight:700;transform:rotate(-2deg)}\n\n    .stepbar{display:grid;grid-template-columns:repeat(5,1fr);gap:10px;margin:18px 0 14px}\n    .step{\n      display:flex;align-items:center;gap:10px;width:100%;min-height:56px;padding:11px 13px;\n      border:1px solid var(--line);border-radius:13px;background:#fff;color:var(--muted);text-align:left;\n      transition:.18s ease;\n    }\n    .step:hover{border-color:var(--green-light)}\n    .step.active{background:var(--green-dark);color:#fff;border-color:var(--green-dark)}\n    .step.done{color:var(--green-dark);border-color:var(--green-light)}\n    .step-no{display:grid;place-items:center;width:29px;height:29px;border:1px solid currentColor;border-radius:50%;font-size:13px;font-weight:700;flex:0 0 29px}\n    .step strong{display:block;font-size:13px;line-height:1.22}\n    .step small{display:block;font-size:11px;margin-top:2px;opacity:.8}\n\n    .progress-wrap{display:flex;align-items:center;gap:12px;margin:0 0 18px;color:var(--muted);font-size:12px}\n    .progress{height:8px;background:#dfe8e2;border-radius:10px;overflow:hidden;flex:1}\n    .progress span{display:block;height:100%;width:0;background:var(--green);transition:width .25s ease}\n\n    .panel{display:none;background:#fff;border:1px solid var(--line);border-radius:18px;box-shadow:0 6px 22px rgba(0,0,0,.045);overflow:hidden}\n    .panel.active{display:block}\n    .panel-head{display:flex;align-items:center;gap:15px;padding:22px 25px;background:var(--soft);border-bottom:1px solid var(--line)}\n    .panel-head:before{content:\"\";width:7px;height:52px;border-radius:8px;background:var(--green)}\n    .panel-head h2{margin:0;color:var(--green-dark);font-size:24px;letter-spacing:-.4px}\n    .panel-head p{margin:4px 0 0;color:var(--muted);font-size:13px}\n    .panel-body{padding:24px 25px 27px}\n    .subsection{margin:4px 0 20px;padding-bottom:11px;border-bottom:1px solid var(--line);color:var(--green);font-size:15px;font-weight:700}\n    .grid{display:grid;grid-template-columns:repeat(12,1fr);gap:16px}\n    .field{grid-column:span 6}\n    .field.third{grid-column:span 4}\n    .field.full{grid-column:1/-1}\n    .field.quarter{grid-column:span 3}\n    label,.label{display:block;margin:0 0 7px;font-size:13px;font-weight:700;color:#314139}\n    .req{color:var(--red)}\n    input,select,textarea{\n      width:100%;border:1px solid #bdcbc2;background:#fff;color:var(--ink);border-radius:10px;padding:11px 12px;outline:none;transition:.15s ease;\n    }\n    textarea{min-height:84px;resize:vertical}\n    input:focus,select:focus,textarea:focus{border-color:var(--green);box-shadow:0 0 0 3px rgba(0,132,61,.12)}\n    input.invalid,select.invalid,textarea.invalid{border-color:var(--danger);background:#fff7f6}\n    .help{margin-top:6px;color:var(--muted);font-size:12px;line-height:1.5}\n    .info{grid-column:1/-1;border-left:5px solid var(--green-light);background:#f5faf7;padding:12px 14px;border-radius:2px 10px 10px 2px;font-size:12px;line-height:1.5;color:#46564d}\n    .info strong{color:var(--green-dark)}\n\n    .choice{display:flex;gap:10px;flex-wrap:wrap}\n    .choice label{position:relative;margin:0;cursor:pointer;font-weight:400}\n    .choice input{position:absolute;opacity:0;pointer-events:none}\n    .choice span{display:flex;align-items:center;justify-content:center;min-width:82px;padding:10px 15px;border:1px solid #bdcbc2;border-radius:10px;background:#fff;font-weight:700;color:#526159;transition:.15s ease}\n    .choice input:checked+span{background:var(--green);color:#fff;border-color:var(--green)}\n    .choice input:focus+span{box-shadow:0 0 0 3px rgba(0,132,61,.13)}\n    .conditional{display:none}\n    .conditional.visible{display:block}\n\n    .repeat-wrap{grid-column:1/-1}\n    .repeat-row{display:grid;grid-template-columns:1.5fr 1fr auto;gap:12px;align-items:end;padding:13px;margin-bottom:10px;background:#f8faf9;border:1px solid var(--line);border-radius:12px}\n    .repeat-row .field{grid-column:auto}\n    .remove-btn{height:42px;min-width:42px;border:1px solid #e4b8b4;border-radius:10px;background:#fff;color:var(--danger);font-weight:700}\n    .remove-btn:hover{background:#fff2f0}\n    .add-btn{border:1px solid var(--green);background:#fff;color:var(--green-dark);border-radius:10px;padding:10px 14px;font-weight:700}\n    .add-btn:hover{background:#edf8f1}\n    .empty-note{padding:14px;border:1px dashed #bfcac3;border-radius:12px;color:var(--muted);font-size:13px;text-align:center}\n\n    .actions{display:flex;justify-content:space-between;gap:12px;margin-top:18px}\n    .actions-right{display:flex;gap:10px;margin-left:auto}\n    .btn{border:0;border-radius:11px;padding:12px 18px;font-weight:700;min-height:45px}\n    .btn.secondary{background:#fff;border:1px solid #b8c8be;color:var(--green-dark)}\n    .btn.primary{background:var(--green);color:#fff}\n    .btn.primary:hover{background:var(--green-dark)}\n    .btn.pdf{background:var(--green-dark);color:#fff;display:flex;align-items:center;gap:9px}\n    .btn.pdf:disabled{opacity:.55;cursor:wait}\n    .btn.ghost{background:transparent;color:var(--muted);padding-left:6px;padding-right:6px}\n\n    .status{display:none;margin-top:15px;padding:13px 15px;border-radius:11px;font-size:13px;line-height:1.45}\n    .status.show{display:block}\n    .status.ok{background:#e9f7ee;border:1px solid #a9d8b8;color:#145c31}\n    .status.err{background:#fff1ef;border:1px solid #efbbb5;color:#8a1f16}\n    .status.wait{background:#fff8dc;border:1px solid #eed77d;color:#6d5910}\n    .status a{color:inherit;font-weight:700}\n    .summary-box{margin-top:18px;border:1px solid var(--line);background:var(--soft);border-radius:13px;padding:15px;color:#425149;font-size:13px;line-height:1.5}\n    .summary-box strong{color:var(--green-dark)}\n    .footer-note{margin:18px 3px 0;color:var(--muted);font-size:11px;line-height:1.5;text-align:center}\n    .label-row{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:7px}\n    .label-row label{margin:0}\n    .mini-copy{border:1px solid var(--green);background:#fff;color:var(--green-dark);border-radius:8px;padding:6px 9px;font-size:11px;font-weight:700;white-space:nowrap}\n    .mini-copy:hover{background:#edf8f1}\n    .date-input{font-variant-numeric:tabular-nums}\n    .legal-copy{grid-column:1/-1;border:1px solid var(--line);border-top:6px solid var(--green);border-radius:12px;background:#fff;padding:20px 22px;max-height:520px;overflow:auto;font-size:12px;line-height:1.45;color:#243028}\n    .legal-copy p{margin:0 0 12px;text-align:justify}\n    .legal-copy h3{margin:17px 0 6px;color:var(--green-dark);font-size:14px}\n    .legal-copy h4{margin:11px 0 4px;font-size:12px}\n    .legal-copy .lead,.legal-copy .confirmation{font-weight:700}\n    .signature-options{grid-column:1/-1;display:grid;grid-template-columns:repeat(2,1fr);gap:12px}\n    .signature-option{position:relative;margin:0;cursor:pointer}\n    .signature-option input{position:absolute;opacity:0;pointer-events:none}\n    .signature-option span{disp